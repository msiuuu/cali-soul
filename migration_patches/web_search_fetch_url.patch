diff --git a/brain/tools/impls/fetch_url.py b/brain/tools/impls/fetch_url.py
new file mode 100644
index 0000000..7fd8f3e
--- /dev/null
+++ b/brain/tools/impls/fetch_url.py
@@ -0,0 +1,81 @@
+"""fetch_url tool — fetch a web page and return its text content."""
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+import httpx
+
+log = logging.getLogger(__name__)
+
+_MAX_BYTES = 256 * 1024
+_TIMEOUT = 20.0
+
+
+def fetch_url(url: str, *, max_chars: int | None = None, **_: Any) -> dict:
+    """Fetch a URL and return text content, stripped of HTML tags."""
+    if not url or not url.strip():
+        return {"error": "empty url"}
+
+    url = url.strip()
+    if not url.startswith(("http://", "https://")):
+        url = "https://" + url
+
+    try:
+        resp = httpx.get(
+            url,
+            timeout=_TIMEOUT,
+            follow_redirects=True,
+            headers={
+                "User-Agent": "Mozilla/5.0 (compatible; CompanionBot/1.0)",
+                "Accept": "text/html,application/xhtml+xml,text/plain,*/*",
+            },
+        )
+        resp.raise_for_status()
+    except httpx.HTTPStatusError as exc:
+        return {"error": f"HTTP {exc.response.status_code}", "url": url}
+    except httpx.RequestError as exc:
+        return {"error": f"request failed: {exc}", "url": url}
+
+    content_type = resp.headers.get("content-type", "")
+    raw = resp.content[:_MAX_BYTES]
+
+    try:
+        text = raw.decode("utf-8", errors="replace")
+    except Exception:
+        return {"error": "could not decode response", "url": url}
+
+    if "html" in content_type.lower():
+        text = _strip_html(text)
+
+    cap = max_chars if max_chars and max_chars > 0 else 50_000
+    if len(text) > cap:
+        text = text[:cap]
+        truncated = True
+    else:
+        truncated = False
+
+    out: dict[str, Any] = {"url": url, "content": text, "length": len(text)}
+    if truncated:
+        out["truncated"] = True
+    return out
+
+
+def _strip_html(html: str) -> str:
+    """Rough HTML→text. Good enough for reading articles."""
+    import re
+
+    html = re.sub(r"<script[^>]*>.*?</script>", "", html, flags=re.DOTALL | re.IGNORECASE)
+    html = re.sub(r"<style[^>]*>.*?</style>", "", html, flags=re.DOTALL | re.IGNORECASE)
+    html = re.sub(r"<nav[^>]*>.*?</nav>", "", html, flags=re.DOTALL | re.IGNORECASE)
+    html = re.sub(r"<header[^>]*>.*?</header>", "", html, flags=re.DOTALL | re.IGNORECASE)
+    html = re.sub(r"<footer[^>]*>.*?</footer>", "", html, flags=re.DOTALL | re.IGNORECASE)
+    html = re.sub(r"<[^>]+>", " ", html)
+    html = re.sub(r"&nbsp;", " ", html)
+    html = re.sub(r"&amp;", "&", html)
+    html = re.sub(r"&lt;", "<", html)
+    html = re.sub(r"&gt;", ">", html)
+    html = re.sub(r"&#\d+;", "", html)
+    html = re.sub(r"&\w+;", "", html)
+    html = re.sub(r"\s+", " ", html)
+    return html.strip()
