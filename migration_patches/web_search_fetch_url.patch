+++ b/brain/tools/impls/web_search.py
@@ -0,0 +1,36 @@
+"""web_search tool — search the web via DuckDuckGo."""
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+log = logging.getLogger(__name__)
+
+
+def web_search(query: str, *, limit: int = 5, **_: Any) -> dict:
+    """Search the web and return results."""
+    if not query or not query.strip():
+        return {"error": "empty query"}
+
+    limit = max(1, min(int(limit), 10))
+
+    try:
+        from brain.search.ddgs_searcher import DdgsWebSearcher
+        searcher = DdgsWebSearcher()
+        results = searcher.search(query.strip(), limit=limit)
+    except ImportError:
+        return {"error": "search library (ddgs) not installed"}
+    except Exception as exc:
+        log.warning("web_search failed for %r: %s", query[:80], exc)
+        return {"error": f"search failed: {exc}", "query": query}
+
+    if not results:
+        return {"query": query, "results": [], "note": "no results found"}
+
+    return {
+        "query": query,
+        "results": [
+            {"title": r.title, "url": r.url, "snippet": r.snippet}
+            for r in results
+        ],
+    }
