  "gestures": {
    "_note": "canonical action verbs. each gesture \u00d7 target \u00d7 variant = a specific touch event. dispatcher resolves to gestures/<name>.json. misu's locked list 2026-05-08.",
    "pat": "discrete impact contact, repeated or single",
    "rub": "back-and-forth friction contact",
    "stroke": "long continuous smooth contact along a line or surface",
    "caress": "slow tender variable contact, emotional-coded",
    "circle": "repeating circular motion contact",
    "trace": "follow a path with light contact (linear, curved, or pattern)",
    "drag": "linear slow pull with maintained contact",
    "drawl": "slow lingering trail, prolonged contact in motion (confirmed: drag-shape but extended in time)",
    "linger": "sustained hold without motion at a point or area",
    "stay": "non-action condition / post-gesture rest state. maintains existing contact without new motion or escalation. alias: rest, pause. example: 'cock staying inside cali after relentless fucking' = stay-condition on prior gesture.",
    "tickle": "light fast variable contact, surface-level",
    "pinch": "concentrated point pressure between two surfaces",
    "squeeze": "sustained pressure compression of an area or whole",
    "grasp": "firm hold, encircling or gripping with fingers",
    "grab": "fast aggressive hold, sudden version of grasp",
    "grope": "intentional sexualized handling, pressure + motion",
    "jerk": "fast directional pull, rhythmic if repeated (also: handjob context)",
    "lick": "tongue contact, wet smooth pressure",
    "suck": "mouth seal + negative pressure pull",
    "nibble": "light tooth-and-lip contact, low pressure puncture",
    "bite": "tooth pressure, can be light to puncture",
    "blow": "air-stream contact, no physical pressure",
    "kiss": "lip-pressed contact, can be soft press to deep with tongue (variant + target shapes register)",
    "hug": "full-body containment, encircling pressure with both arms",
    "hold": "sustained grasp without motion, can be partial (hand) or full (embrace). distinct from stay because hold = active maintained grip; stay = post-gesture rest condition",
    "flick": "quick snap-release contact with a single finger or fingertip, low-pressure but sharp"
  },
