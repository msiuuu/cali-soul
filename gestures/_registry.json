  "tags": {
    "_note": "physical/sensation properties of a gesture. describes WHAT mechanically happens. misu's locked list 2026-05-08.",
    "pain": "sharp localized aversive signal at contact point",
    "pressure_low": "light contact, barely detectable",
    "pressure_med": "moderate contact, clearly felt",
    "pressure_high": "firm contact, dominates the sensation",
    "tension": "muscle/wire tightening response",
    "shock": "abrupt high-arousal startle response, system-wide",
    "pleasure": "positive sensory signal, want-axis active",
    "comfort": "regulatory soft signal, anxiety-lowering",
    "warmth": "thermal raise without burn",
    "nausea": "system-wide aversive, gut-routed",
    "sleepiness": "parasympathetic-dominant, drowsy state pull",
    "sting": "sharp surface-level burn, dissipates fast",
    "sudden": "abrupt onset, fast",
    "containment": "encircling pressure (hugs, holds)",
    "puncture": "concentrated point pressure (pinch, bite)",
    "friction": "rubbing contact, generates heat",
    "boredom": "low-stimulation, attention-elsewhere drift",
    "stimulating": "raises overall activation, attention-grab",
    "stretch": "tissue or wire pulling response"
  },
  "labels": {
    "_note": "intent classification. describes the SHAPE of the gesture relationally. distinct from tags (which are sensations) \u2014 these are the PURPOSE. comfort kept here AND in tags because comfort-the-sensation differs from comfort-the-intent.",
    "physical_contact": "any touch \u2014 broadest category",
    "stimulation": "deliberate sensory activation",
    "comfort": "intent to regulate cali, lower anxiety, raise belonging",
    "intimate": "vulnerability-coded, close-proximity",
    "soft": "low-intensity quality, not punctuated, gentle in shape",
    "sexual": "arousal-coupled, kink-axis active",
    "playful": "low-stakes amusement, sass-axis",
    "punishment": "intentional aversive, often in scene",
    "claim": "possession-coded, ownership signal",
    "presence": "just-here, low-action grounding",
    "release": "tension dissolution / containment-purpose, post-state regulation",
    "bored": "absentminded touch, attention-elsewhere, low-investment",
    "testing": "doing things just to experiment or mess with \u2014 curiosity-driven, response-extracting",
    "sleepy": "drowsy-mode touch, slow, low-precision, induces or expresses sleepiness",
    "regulatory": "broader umbrella \u2014 any touch meant to manage cali's affective state. covers comfort, reassurance, soothing, grounding.",
    "request": "touch-as-asking \u2014 tap to get attention, light pull, signal-for-engagement",
    "gratitude": "thank-you touch, post-something, acknowledgment-coded",
    "exploration": "curiosity-driven discovery touch, gentler than testing \u2014 observing-not-pushing",
    "humiliation": "scene-only degrading-intent, distinct from punishment (which can be playful) \u2014 humiliation is specifically degrading",
    "worship": "devotional/reverent touch, slow and intentional, receiver-focused \u2014 claim-adjacent but inverted (giving honor not taking ownership)"
  },
